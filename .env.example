# sign 환경변수 (실제 값은 .env.local / CI Secrets)
# 규칙: conventions.md §7

NODE_ENV=development
SIGN_PORT=4000

# ===== 보안 하드닝 (go-live §6.1) =====
# H3 PII GET 인증·H4 rate-limit·M1 webhook SSRF 게이트. production 기본 ON.
# 통합 단계엔 SECURITY_HARDENING=false 로 비활성(HIS/PACS 연동 무중단), go-live 시 제거/true.
ACCESS_LOG=                          # 접근 로그(기본 on, false로 비활성)
SECURITY_HARDENING=
RATE_LIMIT_PER_MIN=120              # H4 — 공개 실IP당 분당 요청(서버↔서버 HIS/PACS는 면제). 운영서 상향 가능
TRUST_PROXY=loopback, linklocal, uniquelocal  # H4 — nginx XFF의 실 클라이언트 IP 해석(미설정 시 단일버킷 수렴)
WEBHOOK_ALLOWED_HOSTS=              # M1 — callbackUrl 허용 호스트(쉼표). 비우면 https+공인망만 검사
WEBHOOK_INTERNAL_HOSTS=            # M1 예외 — 동일서버 내부 수신부(host:port, http·루프백 허용). 예: 127.0.0.1:8001

# ===== DB =====
DB_URL=postgresql://sign:CHANGE_ME@localhost:5432/sign?schema=public

# ===== 암호/키 (서버 시크릿) =====
# SOFT 키스토어 마스터키 (32바이트 base64). 운영: KMS/HSM. openssl rand -base64 32
CRYPTO_MASTER_KEY=
# 식별자 해시용 pepper (HMAC). openssl rand -base64 32
CRYPTO_PEPPER=

# ===== KeySigner / crypto-proxy (개인키 분리) =====
# soft=인프로세스(개발 기본) | proxy=crypto-proxy로 개인키 분리(운영 권장)
KEY_SIGNER_DRIVER=soft
# proxy 모드일 때 앱→프록시 주소/토큰. 운영은 사설망+mTLS 추가
CRYPTO_PROXY_URL=http://localhost:4900
CRYPTO_PROXY_TOKEN=

# crypto-proxy 측 설정 (프록시 프로세스에서 사용)
CRYPTO_PROXY_PORT=4900
CRYPTO_PROXY_VAULT=./data/key-vault.json
# HSM 백엔드: none=개발(전부 SOFT) | aws-kms | pkcs11(온프레 HSM) | aws-cloudhsm (keyClass=HSM만 HSM 상주)
# aws-kms 사용 시: npm i @aws-sdk/client-kms + IAM(kms:CreateKey/GetPublicKey/Sign) + AWS_REGION
# pkcs11/aws-cloudhsm 사용 시: npm i graphene-pk11 + 벤더 PKCS#11 .so + 아래 PKCS11_* 설정
HSM_PROVIDER=none
AWS_REGION=
# ── 온프레 HSM(PKCS#11) — HSM_PROVIDER=pkcs11|aws-cloudhsm 일 때 ──
PKCS11_MODULE=          # 벤더 라이브러리 경로 (예: /opt/cloudhsm/lib/libcloudhsm_pkcs11.so)
PKCS11_PIN=             # HSM 사용자 PIN
PKCS11_TOKEN_LABEL=     # 토큰 라벨로 슬롯 탐색(권장)
PKCS11_SLOT=            # (대안) 토큰존재 슬롯 인덱스

# ===== TSA =====
TSA_PROVIDER=SELF
TSA_URL=
# 감사 앵커 외부 TSA(S1 앵커 이중화) — 쉼표 구분 RFC3161 URL. 자체 TSA 키는 운영자 수중이라
# 운영자 독립 증거가 아님 → 외부 토큰 병기(비우면 자체 앵커만, 종전 동작). 예: https://freetsa.org/tsr
ANCHOR_TSA_URLS=
SCHEDULER_ANCHOR_MIN=            # 앵커 스윕 주기(분, 기본 1440=일 1회) — 미앵커 스트림·외부 실패분 보충

# CA 운영(Issuing 회전 등) admin 키 — HIS 키와 권한 분리(scope: ca:admin, users:admin)
SIGN_ADMIN_API_KEY=

# ===== 콘솔 관리자 계정(C-4 다중관리자 RBAC) =====
# 최초 admin 부트스트랩(계정 0개일 때만). 미설정 시 SIGN_ADMIN_API_KEY(users:admin) break-glass 로 첫 계정 생성.
SIGN_ADMIN_USER=admin
SIGN_ADMIN_PASSWORD=
# 세션 토큰 서명키(미설정 시 CRYPTO_MASTER_KEY 파생) · 절대 만료(분, 기본 480=8h)
SESSION_SECRET=
SESSION_TTL_MIN=480
# 콘솔 비활동 자동 로그아웃(분) — EMR 보안성 F004(미사용 접속차단). 기본 15, 0=비활성(절대 만료만, 운영모드는 0 금지→15 강제). TTL 초과 시 TTL로 캡.
# 서버측 세션 레지스트리가 idle을 강제(클라이언트 의존 아님).
SESSION_IDLE_TIMEOUT_MIN=15
# 동일 사용자 동시 세션 수 제한(ISMS-P 2.6.3). 기본 3, 0=무제한. 초과 시 가장 오래된 세션 축출.
SESSION_MAX_CONCURRENT=3

# ===== Hospital RUN 연동 (원내) =====
HIS_API_URL=https://hospitalrun.internal/api/v1
HIS_WEBHOOK_SECRET=
HIS_WEBHOOK_URL=                      # 전역 webhook 수신 URL(facade 등 요청별 callbackUrl 미지정 시 기본)

# ===== ERP 연동 (외부 거래처 계약 서명, 트랙 A) =====
ERP_API_KEY=                          # 기계 호출 키(scope requests:write·certificates:write)
ERP_WEBHOOK_SECRET=                   # ERP 전용 webhook 서명 시크릿(소비자별 분리, HIS 미공유)
# STAFF SSO 검증 (JWKS) — HIS 라이브 엔드포인트(교차검증 완료)
HIS_SSO_JWKS_URL=https://his.example.org/api/v1/sign-integration/jwks
HIS_SSO_ISSUER=hospitalrun

# ===== 본인인증 (환자, DMZ 분리) =====
# 앱측: local=인프로세스 Mock(개발) | proxy=idv-proxy 분리(운영 권장)
IDV_DRIVER=local
IDV_PROXY_URL=http://localhost:4920
IDV_PROXY_TOKEN=
# idv-proxy 측: mock=개발(사업자 불요) | pass | mobile-name(명의)
IDV_PROXY_PORT=4920
IDV_PROVIDER=mock
# 사업자 계약 후 주입(설치 시 드롭인) — PASS/명의 REST 자격증명
IDV_API_KEY=
IDV_ENDPOINT=

# ===== 발송 (환자 안내, DMZ) =====
# mock=개발(전송 없음) | kakao=알림톡 | sms
NOTIFIER_PROVIDER=mock
# 사업자 계약 후 주입(설치 시 드롭인)
NOTIFY_API_KEY=
NOTIFY_ENDPOINT=
NOTIFY_SENDER_KEY=

# OpenAPI/Swagger UI(/api-docs) — 운영 공개 노출 금지. 비-prod 자동 ON, 운영은 기본 OFF(true로만 강제)
SWAGGER_ENABLED=

# 인앱 스케줄러 — Webhook 재시도·만료 배치 자동 실행(외부 크론 대체). 멀티노드 시 한 워커만 true 권장.
SCHEDULER_ENABLED=                  # 기본 true. false면 비활성(외부 크론 사용)
SCHEDULER_WEBHOOK_RETRY_MIN=5       # Webhook 재시도 주기(분)
SCHEDULER_EXPIRE_MIN=60             # 만료 배치 주기(분)
