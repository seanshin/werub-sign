# sign 운영 배포 env (docker-compose.prod.yml). 실제 .env.prod 는 gitignore — 서버에만 보관.
# 생성: openssl rand -base64 32

# ── 포트(공유 서버 충돌 회피: 4000/3000 점유 시 변경) ──
SIGN_BIND=127.0.0.1
SIGN_HOST_PORT=4100
WEB_BIND=127.0.0.1
WEB_HOST_PORT=3050

# ── DB ──
POSTGRES_PASSWORD=

# ── 시크릿(필수) ──
CRYPTO_MASTER_KEY=
CRYPTO_PEPPER=
HIS_INBOUND_API_KEY=
HIS_WEBHOOK_SECRET=
# 콘솔 break-glass 키(계정 인증 장애 시 폴백) — HIS 키와 분리
CONSOLE_API_KEY=
# PACS 연동 전용(판독보고서 서명 + 영상 동의서)
PACS_API_KEY=
# ERP 외부 거래처 계약 서명(트랙 A) — 기계 키 + 전용 webhook 시크릿(소비자별 분리)
ERP_API_KEY=
ERP_WEBHOOK_SECRET=
# CA 운영 + 사용자관리(scope: ca:admin, users:admin) break-glass
SIGN_ADMIN_API_KEY=

# ── 콘솔 관리자 계정(C-4 RBAC) ── 최초 admin 부트스트랩(계정 0개 시). 미설정 시 SIGN_ADMIN_API_KEY 로 첫 계정 생성.
SIGN_ADMIN_USER=admin
SIGN_ADMIN_PASSWORD=
SESSION_SECRET=
SESSION_TTL_MIN=480
# 콘솔 비활동 자동 로그아웃(분) — EMR 보안성 F004(미사용 접속차단). 기본 15, 0=비활성(운영모드는 0 금지→15 강제). TTL 초과 시 TTL로 캡.
SESSION_IDLE_TIMEOUT_MIN=15
# 동일 사용자 동시 세션 수 제한(ISMS-P 2.6.3). 기본 3, 0=무제한. 초과 시 오래된 세션 축출.
SESSION_MAX_CONCURRENT=3

# ── HIS 연동(라이브 교차검증 값) ──
HIS_SSO_JWKS_URL=https://his.example.org/api/v1/sign-integration/jwks
HIS_SSO_ISSUER=hospitalrun
HIS_SSO_AUDIENCE=sign
# STAFF role allow-list(선택, csv) — 설정 시 해당 role만 서명 허용(예: DOCTOR)
HIS_SSO_ALLOWED_ROLES=

# ── 프론트(same-origin이면 빈 값 유지) · CORS ──
NEXT_PUBLIC_SIGN_API_URL=
CORS_ORIGINS=https://sign.example.org
# portalUrl·auditCertUri 생성 베이스(공개 도메인)
PUBLIC_BASE_URL=https://sign.example.org
NOTIFIER_PROVIDER=mock

# ── 감사 앵커 이중화(보안 S1) — 외부 RFC3161 TSA(쉼표 구분) ──
# 자체 TSA 키는 운영자 수중이라 외부 토큰이 있어야 운영자 독립 증거가 된다.
# 공개 TSA 로 시작 가능(공인 TSA 계약 시 URL 만 교체): https://freetsa.org/tsr
ANCHOR_TSA_URLS=https://freetsa.org/tsr
SCHEDULER_ANCHOR_MIN=1440
